<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hybris</groupId>
    <artifactId>hybris-ootb-demo</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>SAP Hybris OOTB Demo</name>

    <modules>
        <module>hybriscore</module>
        <module>hybriscommercefacades</module>
        <module>hybrisocc</module>
        <module>hybrisstorefront</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.hybris</groupId>
                <artifactId>hybriscore</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hybris</groupId>
                <artifactId>hybriscommercefacades</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hybris</groupId>
                <artifactId>hybrisocc</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
